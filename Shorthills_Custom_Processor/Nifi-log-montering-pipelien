ntrollerService":false,"sensitive":false,"dynamic":false},"Output Format":{"name":"Output Format","displayName":"Output Format","identifiesControllerService":false,"sensitive":false,"dynamic":false},"Log Payload":{"name":"Log Payload","displayName":"Log Payload","identifiesControllerService":false,"sensitive":false,"dynamic":false}},"style":{},"schedulingPeriod":"0 sec","schedulingStrategy":"TIMER_DRIVEN","executionNode":"ALL","penaltyDuration":"30 sec","yieldDuration":"1 sec","bulletinLevel":"WARN","runDurationMillis":25,"concurrentlySchedulableTaskCount":1,"autoTerminatedRelationships":["success"],"scheduledState":"ENABLED","retryCount":10,"retriedRelationships":[],"backoffMechanism":"PENALIZE_FLOWFILE","maxBackoffPeriod":"10 mins","componentType":"PROCESSOR","groupIdentifier":"1760fe8c-bc47-36e6-816a-80b95ff0e412"},{"identifier":"7fe93193-cc61-318a-b783-371c4d34d4cb","instanceIdentifier":"5f7661ba-a2f4-30f9-824b-f4154f608c7b","name":"Chunk based on timestamp format - ExecuteScript","comments":"","position":{"x":-288.0,"y":-648.0},"type":"org.apache.nifi.processors.script.ExecuteScript","bundle":{"group":"org.apache.nifi","artifact":"nifi-scripting-nar","version":"2.4.0"},"properties":{"Script File":null,"Script Engine":"Groovy","Script Body":"import org.apache.nifi.processor.io.InputStreamCallback // Import InputStreamCallback\nimport java.nio.charset.StandardCharsets\nimport java.util.regex.Pattern\n\ndef flowFile = session.get()\nif (flowFile == null) {\n    return\n}\n\n// Regex to identify the start of a new log entry (timestamp pattern)\ndef timestampPattern = Pattern.compile(\"^\\\\d{4}-\\\\d{2}-\\\\d{2} \\\\d{2}:\\\\d{2}:\\\\d{2},\\\\d{3} .*\")\n\n// Get the UUID using getAttribute() for logging if needed\ndef originalFlowFileUuid = flowFile.getAttribute('uuid')\n\ntry {\n    // Corrected: Use InputStreamCallback\n    session.read(flowFile, { inputStream ->\n        def content = new String(inputStream.bytes, StandardCharsets.UTF_8)\n        def lines = content.split('\\n')\n\n        def currentLogEntry = new StringBuilder()\n        int entryCount = 0\n\n        lines.eachWithIndex { line, index ->\n            if (timestampPattern.matcher(line).find()) {\n                if (currentLogEntry.length() > 0) {\n                    def newFlowFile = session.create(flowFile) // Copies existing attributes from original FlowFile\n                    session.write(newFlowFile, { outputStream ->\n                        outputStream.write(currentLogEntry.toString().getBytes(StandardCharsets.UTF_8))\n                    } as org.apache.nifi.processor.io.OutputStreamCallback) // Also specify OutputStreamCallback here\n                    session.transfer(newFlowFile, REL_SUCCESS)\n                    entryCount++\n                }\n                currentLogEntry = new StringBuilder(line)\n            } else {\n                currentLogEntry.append('\\n').append(line)\n            }\n        }\n\n        if (currentLogEntry.length() > 0) {\n            def newFlowFile = session.create(flowFile)\n            session.write(newFlowFile, { outputStream ->\n                outputStream.write(currentLogEntry.toString().getBytes(StandardCharsets.UTF_8))\n            } as org.apache.nifi.processor.io.OutputStreamCallback) // Also specify OutputStreamCallback here\n            session.transfer(newFlowFile, REL_SUCCESS)\n            entryCount++\n        }\n\n        // Corrected line for logging:\n        log.info(\"Successfully split FlowFile ${originalFlowFileUuid} into ${entryCount} log entries.\")\n\n    } as InputStreamCallback) // Corrected: Use InputStreamCallback\n\n    session.remove(flowFile) // Remove the original FlowFile as it's been split\n\n} catch (e) {\n    // Corrected line for logging in the catch block:\n    log.error(\"Failed to split FlowFile ${originalFlowFileUuid} due to ${e.getMessage()}\", e)\n    session.transfer(flowFile, REL_FAILURE)\n}","Module Directory":null},"propertyDescriptors":{"Script File":{"name":"Script File","displayName":"Script File","identifiesControllerService":false,"sensitive":false,"dynamic":false,"resourceDefinition":{"cardinality":"SINGLE","resourceTypes":["FILE"]}},"Script Engine":{"name":"Script Engine","displayName":"Script Engine","identifiesControllerService":false,"sensitive":false,"dynamic":false},"Script Body":{"name":"Script Body","displayName":"Script Body","identifiesControllerService":false,"sensitive":false,"dynamic":false},"Module Directory":{"name":"Module Directory","displayName":"Module Directory","identifiesControllerService":false,"sensitive":false,"dynamic":false,"resourceDefinition":{"cardinality":"MULTIPLE","resourceTypes":["FILE","DIRECTORY"]}}},"style":{},"schedulingPeriod":"0 sec","schedulingStrategy":"TIMER_DRIVEN","executionNode":"ALL","penaltyDuration":"30 sec","yieldDuration":"1 sec","bulletinLevel":"NONE","runDurationMillis":0,"concurrentlySchedulableTaskCount":1,"autoTerminatedRelationships":[],"scheduledState":"ENABLED","retryCount":10,"retriedRelationships":[],"backoffMechanism":"PENALIZE_FLOWFILE","maxBackoffPeriod":"10 mins","componentType":"PROCESSOR","groupIdentifier":"1760fe8c-bc47-36e6-816a-80b95ff0e412"},{"identifier":"85cdb65b-0197-1000-c9a1-f1cdc34b575e","instanceIdentifier":"751089de-67b8-331d-9dbc-e17aa8e24e3c","name":"messageformatterExecuteScript","comments":"","position":{"x":856.0,"y":-1208.0},"type":"org.apache.nifi.processors.script.ExecuteScript","bundle":{"group":"org.apache.nifi","artifact":"nifi-scripting-nar","version":"2.4.0"},"properties":{"Script File":null,"Script Engine":"Groovy","Script Body":"import org.apache.nifi.processor.io.InputStreamCallback\nimport org.apache.nifi.processor.io.OutputStreamCallback\nimport org.apache.nifi.processor.Relationship // Required for Relationship.Builder\nimport java.nio.charset.StandardCharsets\nimport java.util.regex.Pattern\n \n// Define Relationships explicitly for ExecuteScript\ndef REL_SUCCESS = new Relationship.Builder().name(\"success\").description(\"Success\").build()\ndef REL_FAILURE = new Relationship.Builder().name(\"failure\").description(\"Failure\").build()\n \ndef flowFile = session.get()\nif (!flowFile) {\n    return // No FlowFile to process\n}\n \ntry {\n    // 1. Access existing FlowFile attributes (these will be used as fallbacks if not found in log message)\n    def processGroupId = flowFile.getAttribute('processgroup.id') ?: 'N/A'\n    def processGroupName = flowFile.getAttribute('processgroup.name') ?: 'N/A'\n    def log_message_attr =  flowFile.getAttribute('LOG_MESSAGE') ?: 'N/A' // Use a different variable name to avoid confusion\n \n   \n    // 2. Read the content of the FlowFile (the original error log line)\n    def originalLogLine = new StringBuilder()\n    session.read(flowFile, { inputStream ->\n        originalLogLine.append(new String(inputStream.bytes, StandardCharsets.UTF_8))\n    } as InputStreamCallback)\n    def fulllogmessage = originalLogLine.toString().trim()\n \n    // --- Primary Regex: Extract Timestamp, Log Level, Processor Name, Processor ID, and the ENTIRE REST of the message ---\n    // Group 1: Timestamp\n    // Group 2: Processor Name\n    // Group 3: Processor ID\n    // Group 4: The remainder of the message after the processor ID\n\n    def primaryPattern = Pattern.compile(\n        \"\"\"(?s)^(\\\\d{4}-\\\\d{2}-\\\\d{2} \\\\d{2}:\\\\d{2}:\\\\d{2},\\\\d{3})\\\\s+(INFO|WARN|ERROR|DEBUG|TRACE|FATAL)\\\\s+\\\\[.*?\\\\]\\\\s+.*?\\\\s+(\\\\w+)\\\\[id=([\\\\w-]+)\\\\]\\\\s*(.*)\\$\"\"\",\n        Pattern.DOTALL // Needed for Group 5 to capture newlines if they are present in the original log message\n    )\n    def matcher = fulllogmessage =~ primaryPattern\n \n    def extractedTimestamp = \"UnknownTimestamp\" // Default value\n    def processorName = \"UnknownProcessor\"\n    def processorId = \"UnknownID\"\n    def filename = \"FlowFile_Name_Not_In_Log\" // Default to show it wasn't found in log\n    def uuid = \"FlowFile_ID_Not_In_Log\" // Default to show it wasn't found in log\n    def specificlogMessage = fulllogmessage // Default to full message if no parsing occurs\n \n    if (matcher.matches()) {\n        extractedTimestamp = matcher.group(1) // Captured timestamp\n        extractedLogLevel = matcher.group(2)  // Captured log level (e.g., INFO, ERROR)\n        processorName = matcher.group(3)      // Captured Processor Name\n        processorId = matcher.group(4)        // Captured Processor ID\n        flowFile = session.putAttribute(flowFile, \"processor_id\", processorId) // Add processor_id attribute\n        def remainingMessage = matcher.group(5)?.trim() // The rest of the log line after processor ID\n \n        // --- Secondary Regex: Try to extract FlowFile details from the 'remainingMessage' ---\n        // Group 1: FlowFile UUID\n        // Group 2: FlowFile Name\n        def ffDetailsPattern = Pattern.compile(\n            \"\"\"StandardFlowFileRecord\\\\[uuid=([\\\\w-]+),.*?name=([^,\\\\}\\\\]]+).*?\\\\]\"\"\",\n            Pattern.DOTALL\n        )\n        def ffMatcher = remainingMessage =~ ffDetailsPattern\n \n        if (ffMatcher.find()) {\n            uuid = ffMatcher.group(1) // Captured FlowFile UUID\n            filename = ffMatcher.group(2) // Captured FlowFile Name\n            // Remove the matched FlowFileRecord part from the remainingMessage to get the clean specificlogMessage\n            specificlogMessage = remainingMessage.replace(ffMatcher.group(0), \"\").trim()\n        } else {\n            // If FlowFileRecord not found, use attributes as fallback or keep \"Not_In_Log\" defaults\n            filename = \"FlowFile_Name_Not_In_Log\"\n            uuid = \"FlowFile_ID_Not_In_Log\"\n            specificlogMessage = remainingMessage // No FF details to strip, so the whole remainder is the message\n        }\n    } else {\n        log.warn(\"ExecuteScript: Could not parse main log components (timestamp, processor name/ID). Falling back to attributes and full message. Line: {}\", fulllogmessage)\n        // If primary regex fails, fall back to FlowFile attributes for filename/uuid\n        filename = \"FlowFile_Name_Not_In_Log\"\n        uuid = \"FlowFile_ID_Not_In_Log\"\n        // specificlogMessage already defaults to fulllogmessage\n    }\n \n    // 4. Construct the new formatted message with extracted timestamp and details\n    def outputMessage = \"\"\"This Event Occured at Timestamp:${extractedTimestamp ?: 'N/A'}\nTraceback of log Message  ==>\nProcess_Group_name(_id).Processor_name(_id).flowfile_name(_id): [${processGroupName ?: 'N/A'}(${processGroupId ?: 'N/A'})].[${processorName ?: 'N/A'}(${processorId ?: 'N/A'})].[${filename ?: 'N/A'}(${uuid ?: 'N/A'})],\n\"${log_message_attr}\" Message: \"${fulllogmessage}\" \"\"\" // Retained your chosen ${log_message_attr} here\n \n    // 5. Write the new content back to the FlowFile\n    flowFile = session.write(flowFile, { outputStream ->\n        outputStream.write(outputMessage.getBytes(StandardCharsets.UTF_8))\n    } as OutputStreamCallback)\n \n    // Transfer the FlowFile to the success relationship\n    session.transfer(flowFile, REL_SUCCESS)\n \n} catch (e) {\n    // Log the error and transfer FlowFile to failure\n    log.error(\"Failed to process flow file with UUID {}: {}\", flowFile.getAttribute('uuid'), e.message, e)\n    session.transfer(flowFile, REL_FAILURE)\n}","Module Directory":null},"propertyDescriptors":{"Script File":{"name":"Script File","displayName":"Script File","identifiesControllerService":false,"sensitive":false,"dynamic":false,"resourceDefinition":{"cardinality":"SINGLE","resourceTypes":["FILE"]}},"Script Engine":{"name":"Script Engine","displayName":"Script Engine","identifiesControllerService":false,"sensitive":false,"dynamic":false},"Script Body":{"name":"Script Body","displayName":"Script Body","identifiesControllerService":false,"sensitive":false,"dynamic":false},"Module Directory":{"name":"Module Directory","displayName":"Module Directory","identifiesControllerService"