me","identifiesControllerService":false,"sensitive":false,"dynamic":true}},"style":{},"schedulingPeriod":"0 sec","schedulingStrategy":"TIMER_DRIVEN","executionNode":"ALL","penaltyDuration":"30 sec","yieldDuration":"1 sec","bulletinLevel":"WARN","runDurationMillis":25,"concurrentlySchedulableTaskCount":1,"autoTerminatedRelationships":[],"scheduledState":"ENABLED","retryCount":10,"retriedRelationships":[],"backoffMechanism":"PENALIZE_FLOWFILE","maxBackoffPeriod":"10 mins","componentType":"PROCESSOR","groupIdentifier":"1760fe8c-bc47-36e6-816a-80b95ff0e412"},{"identifier":"7fcc44b4-0197-1000-6dbe-4b710445d893","instanceIdentifier":"38b50f0c-6332-3ddf-b65c-b4291e7db6b1","name":"filteronloglevelExecuteScript","comments":"","position":{"x":-288.0,"y":-936.0},"type":"org.apache.nifi.processors.script.ExecuteScript","bundle":{"group":"org.apache.nifi","artifact":"nifi-scripting-nar","version":"2.4.0"},"properties":{"Script File":null,"Script Engine":"Groovy","Script Body":"import org.apache.nifi.processor.io.InputStreamCallback\nimport java.nio.charset.StandardCharsets\nimport org.apache.nifi.processor.Relationship // Ensure this import is there\nimport java.util.regex.Pattern\n \ndef flowFile = session.get()\nif (flowFile == null) {\n    return\n}\n// Define relationships for the processor\ndef REL_SUCCESS = new Relationship.Builder()\n    .name(\"success\")\n    .description(\"FlowFiles that were successfully processed\")\n    .build()\n\ndef REL_FAILURE = new Relationship.Builder()\n    .name(\"failure\")\n    .description(\"FlowFiles that failed processing\")\n    .build()\n\ndef originalFlowFileUuid = flowFile.getAttribute('uuid')\n// Retrieve the log_level attribute and convert it to uppercase for case-insensitive comparison\ndef configuredLogLevel = flowFile.getAttribute('log_level')?.toUpperCase()\n\n// Define Relationship objects by iterating through available relationships from the context\ndef successRelationship = null\ndef failureRelationship = null\n\n// Iterate through the relationships provided by the ProcessContext\nfor (Relationship rel : context.getAvailableRelationships()) {\n    if (rel.getName() == 'success') {\n        successRelationship = rel\n    } else if (rel.getName() == 'failure') {\n        failureRelationship = rel\n    }\n}\n\n// Perform basic null checks for relationships - these are critical here\nif (successRelationship == null) {\n    log.error(\"Relationship 'success' not found in ExecuteScript configuration! Cannot proceed. Removing FlowFile ${originalFlowFileUuid}.\")\n    session.transfer(flowFile,REL_FAILURE)\n    return\n}\nif (failureRelationship == null) {\n    log.error(\"Relationship 'failure' not found in ExecuteScript configuration! Cannot proceed. Removing FlowFile ${originalFlowFileUuid}.\")\n    session.transfer(flowFile,REL_FAILURE)\n    return\n}\n\ntry {\n   \n    // 2. Read the content of the FlowFile (the original error log line)\n    def originalLogLine = new StringBuilder()\n    session.read(flowFile, { inputStream ->\n        originalLogLine.append(new String(inputStream.bytes, StandardCharsets.UTF_8))\n    } as InputStreamCallback)\n    def fulllogmessage = originalLogLine.toString().trim()\n \n    // --- Primary Regex: Extract Timestamp, Log Level, Processor Name, Processor ID, and the ENTIRE REST of the message ---\n    // Group 1: Timestamp\n    // Group 2: Processor Name\n    // Group 3: Processor ID\n    // Group 4: The remainder of the message after the processor ID\n\n    def primaryPattern = Pattern.compile(\n        \"\"\"(?s)^(\\\\d{4}-\\\\d{2}-\\\\d{2} \\\\d{2}:\\\\d{2}:\\\\d{2},\\\\d{3})\\\\s+(INFO|WARN|ERROR|DEBUG|TRACE|FATAL)\\\\s+\\\\[.*?\\\\]\\\\s+.*?\\\\s+(\\\\w+)\\\\[id=([\\\\w-]+)\\\\]\\\\s*(.*)\\$\"\"\",\n        Pattern.DOTALL // Needed for Group 5 to capture newlines if they are present in the original log message\n    )\n    def matcher = fulllogmessage =~ primaryPattern\n    def extractedLogLevel = \"\"\n        if (matcher.matches()) {\n        extractedLogLevel = matcher.group(2)\n        }\n    def sendToSuccess = false\n\n   \nif (matcher.matches()) {\n    extractedLogLevel = matcher.group(2)\n}\n\n\n\n// Check content for various log levels (case-insensitive)\ndef contentHasDebug = false\ndef contentHasInfo = false\ndef contentHasWarn = false\ndef contentHasError = false\n\nif (extractedLogLevel.equalsIgnoreCase(\"DEBUG\")) {\n    contentHasDebug = true\n} else if (extractedLogLevel.equalsIgnoreCase(\"INFO\")) {\n    contentHasInfo = true\n} else if (extractedLogLevel.equalsIgnoreCase(\"WARN\")) {\n    contentHasWarn = true\n} else if (extractedLogLevel.equalsIgnoreCase(\"ERROR\")) {\n    contentHasError = true\n}\n\n    // Implement the routing logic based on the configured log_level attribute\n    switch (configuredLogLevel) {\n        case \"DEBUG\":\n            // If log_level is DEBUG, success if content has DEBUG, INFO, WARN, or ERROR\n            if (contentHasDebug || contentHasInfo || contentHasWarn || contentHasError) {\n                sendToSuccess = true\n            }\n            break\n        case \"INFO\":\n            // If log_level is INFO, success if content has INFO, WARN, or ERROR\n            if (contentHasInfo || contentHasWarn || contentHasError) {\n                sendToSuccess = true\n            }\n            break\n        case \"WARN\":\n            // If log_level is WARN, success if content has WARN or ERROR\n            if (contentHasWarn || contentHasError) {\n                sendToSuccess = true\n            }\n            break\n        case \"ERROR\":\n            // If log_level is ERROR, success if content has ERROR\n            if (contentHasError) {\n                sendToSuccess = true\n            }\n            break\n        default:\n            // Handle cases where log_level attribute is missing or invalid\n            log.warn(\"FlowFile ${originalFlowFileUuid} has unknown or missing 'log_level' attribute: '${configuredLogLevel}'. Defaulting to failure.\")\n            sendToSuccess = false // Explicitly set to false, will go to failure\n            break\n    }\n\n    if (sendToSuccess) {\n        def nameAttributeValue = \"\"\n        // Determine the highest log level present in the content that caused success\n        if (contentHasError) {\n            nameAttributeValue = \"ERROR\"\n        } else if (contentHasWarn) {\n            nameAttributeValue = \"WARN\"\n        } else if (contentHasInfo) {\n            nameAttributeValue = \"INFO\"\n        } else if (contentHasDebug) {\n            nameAttributeValue = \"DEBUG\"\n        }\n        \n        // Put the new attribute 'name' on the FlowFile\n        flowFile = session.putAttribute(flowFile, \"LOG_MESSAGE\", nameAttributeValue)\n\n        log.info(\"FlowFile ${originalFlowFileUuid} matched configured log_level '${configuredLogLevel}' criteria. Put attribute 'name=${nameAttributeValue}'. Transferred to 'success'.\")\n        session.transfer(flowFile, successRelationship)\n    } else {\n        log.info(\"FlowFile ${originalFlowFileUuid} did NOT match configured log_level '${configuredLogLevel}' criteria. Transferred to 'failure'.\")\n        \n        def nameAttributeValue = \"\"\n        // Determine the highest log level present in the content that caused success\n        if (contentHasError) {\n            nameAttributeValue = \"ERROR\"\n        } else if (contentHasWarn) {\n            nameAttributeValue = \"WARN\"\n        } else if (contentHasInfo) {\n            nameAttributeValue = \"INFO\"\n        } else if (contentHasDebug) {\n            nameAttributeValue = \"DEBUG\"\n        }\n        \n        // Put the new attribute 'name' on the FlowFile\n        flowFile = session.putAttribute(flowFile, \"LOG_MESSAGE\", nameAttributeValue)\n        session.transfer(flowFile,REL_FAILURE) }\n\n} catch (e) {\n    log.error(\"Failed to process FlowFile ${originalFlowFileUuid} due to ${e.getMessage()}\", e)\n    session.transfer(flowFile,REL_FAILURE)\n}",