t":10,"retriedRelationships":[],"backoffMechanism":"PENALIZE_FLOWFILE","maxBackoffPeriod":"10 mins","componentType":"PROCESSOR","groupIdentifier":"1760fe8c-bc47-36e6-816a-80b95ff0e412"},{"identifier":"24b897a3-6c6b-3500-b87e-43a54a6a692c","instanceIdentifier":"e894f7ef-0197-1000-ffff-ffffe4edbc9c","name":"Just Upper ProcessGroupId getter ExecuteScript","comments":"","position":{"x":1192.0,"y":-920.0},"type":"org.apache.nifi.processors.script.ExecuteScript","bundle":{"group":"org.apache.nifi","artifact":"nifi-scripting-nar","version":"2.4.0"},"properties":{"Script File":null,"Script Engine":"Groovy","Script Body":"import javax.net.ssl.*\nimport java.security.SecureRandom\nimport java.security.cert.X509Certificate\n\n// Disable SSL Certificate Validation (NOT for production)\ndef disableSslVerification() {\n    TrustManager[] trustAllCerts = [\n        new X509TrustManager() {\n            X509Certificate[] getAcceptedIssuers() { return null }\n            void checkClientTrusted(X509Certificate[] certs, String authType) { }\n            void checkServerTrusted(X509Certificate[] certs, String authType) { }\n        }\n    ]\n\n    SSLContext sc = SSLContext.getInstance(\"SSL\")\n    sc.init(null, trustAllCerts, new SecureRandom())\n    HttpsURLConnection.setDefaultSSLSocketFactory(sc.getSocketFactory())\n    HttpsURLConnection.setDefaultHostnameVerifier(new HostnameVerifier() {\n        boolean verify(String hostname, SSLSession session) { return true }\n    })\n}\n\ndisableSslVerification()// Import necessary NiFi and Java classes\nimport org.apache.nifi.flowfile.FlowFile\nimport org.apache.nifi.flowfile.attributes.CoreAttributes\nimport groovy.json.JsonSlurper\nimport java.net.URL\nimport org.apache.nifi.processor.Relationship\nimport java.nio.charset.StandardCharsets\nimport java.io.File // Add for File operations\nimport java.net.HttpURLConnection // Re-add for HttpURLConnection\nimport java.io.BufferedReader // Explicitly add for BufferedReader\nimport java.io.InputStreamReader // Explicitly add for InputStreamReader\nimport org.apache.nifi.processor.io.StreamCallback // Keep if needed for other parts of the script, but not directly used in this logic snippet\n\n// Define relationships for the processor\ndef REL_SUCCESS = new Relationship.Builder()\n    .name(\"success\")\n    .description(\"FlowFiles that were successfully processed\")\n    .build()\n\ndef REL_FAILURE = new Relationship.Builder()\n    .name(\"failure\")\n    .description(\"FlowFiles that failed processing\")\n    .build()\n\n// Main processing logic\ndef flowFile = session.get()\nif (flowFile == null) {\n    return // No FlowFile to process, exit\n}\n\n// 1. Get the 'ipaddress' attribute from the FlowFile.\n//    Make sure your FlowFile has an attribute named 'Node_IP_Address'.\ndef ipAddressAttribute = flowFile.getAttribute('Node_IP_Address')\n\n// --- Determine the correct access token file path based on IP ---\ndef currentAccessTokenFilePath // Declare a variable to hold the chosen path\n\nif (ipAddressAttribute == '172.200.58.63') {\n    currentAccessTokenFilePath = '/home/nifi/nifi2/access_token1.txt'\n} else {\n    // This is the fix: use the default token file for other IPs\n    currentAccessTokenFilePath = '/home/nifi/nifi2/access_token.txt'\n}\n\n// Add a validation check to ensure a path was determined\nif (currentAccessTokenFilePath == null) {\n    log.error \"FATAL: Access token file path could not be determined for IP ${ipAddressAttribute}. Routing to failure.\"\n    session.transfer(flowFile, REL_FAILURE)\n    return\n}\n// -----------------------------------------\n\n\n/**\n * Reads the access token from a specified file.\n * @param filePath The path to the file containing the access token.\n * @return The access token as a String, or null if the file cannot be read or is empty.\n */\ndef readAccessTokenFromFile(String filePath) {\n    def token = null\n    def tokenFile = new File(filePath)\n    if (tokenFile.exists() && tokenFile.canRead()) {\n        try {\n            token = tokenFile.text.trim() // .trim() removes leading/trailing whitespace like newlines\n            if (token.isEmpty()) {\n                log.warn \"Access token file exists but is empty: ${filePath}\"\n                token = null\n            } else {\n                log.info \"Successfully read access token from file: ${filePath}\"\n            }\n        } catch (IOException e) {\n            log.error \"Error reading access token from file ${filePath}: ${e.message}\", e\n        }\n    } else {\n        log.warn \"Access token file not found or not readable: ${filePath}. Ensure your cron job is running and saving the token.\"\n    }\n    return token\n}\n\n/**\n * Retrieves processor details from the NiFi API.\n * @param baseUrl The base URL of the NiFi API (e.g., \"http://localhost:8080/nifi-api\").\n * @param accessToken The bearer token for authentication.\n * @param processorId The ID of the processor to get details for.\n * @return The JSON response string containing processor details, or null on failure.\n */\ndef getProcessorDetails(String baseUrl, String accessToken, String processorId) {\n    log.info \"Attempting to get details for processor ID: ${processorId} from ${baseUrl}/processors/${processorId}...\"\n    def jsonResponse = null\n    def processorDetailsUrl = new URL(\"${baseUrl}/processors/${processorId}\")\n    HttpURLConnection conn = null\n\n    try {\n        conn = processorDetailsUrl.openConnection() as HttpURLConnection\n        conn.setRequestMethod(\"GET\")\n        conn.setRequestProperty(\"Authorization\", \"Bearer ${accessToken}\")\n        conn.setRequestProperty(\"Accept\", \"application/json\")\n\n        def responseCode = conn.getResponseCode()\n        if (responseCode == HttpURLConnection.HTTP_OK) {\n            def reader = new BufferedReader(new InputStreamReader(conn.getInputStream(), 'UTF-8'))\n            jsonResponse = reader.collect { it }.join('\\n')\n            reader.close()\n            log.info \"Successfully retrieved processor details (HTTP Status: ${responseCode}).\"\n        } else {\n            def errorReader = new BufferedReader(new InputStreamReader(conn.getErrorStream() ?: conn.getInputStream(), 'UTF-8'))\n            def errorBody = errorReader.collect { it }.join('\\n')\n            errorReader.close()\n            log.error \"ERROR: Failed to get processor details. Status: ${responseCode} - ${conn.getResponseMessage()}. Response Body: ${errorBody}\"\n        }\n    } catch (java.net.ConnectException e) {\n        log.error \"ERROR: Connection refused when getting processor details. NiFi server might be down or unreachable: ${e.message}\", e\n    } catch (Exception e) {\n        log.error \"ERROR: Unexpected error when getting processor details: ${e.message}\", e\n    } finally {\n        if (conn != null) {\n            conn.disconnect()\n        }\n    }\n    return jsonResponse\n}\n\n\ntry {\n    log.info(\"Processing FlowFile: ${flowFile.getAttribute(CoreAttributes.FILENAME.key()) ?: flowFile.getId()}\")\n\n    // 1. Retrieve necessary attributes from the FlowFile\n    def processgroup_url = flowFile.getAttribute('processgroup_url')\n    def ProcessorId = flowFile.getAttribute('processor_id')\n\n    // --- Validation of required FlowFile attributes ---\n    if (!processgroup_url || processgroup_url.isEmpty()) {\n        log.error \"FATAL: 'processgroup_url' attribute not found or is empty in FlowFile ID ${flowFile.getId()}. Cannot construct NiFi API URL. Routing to failure.\"\n        session.transfer(flowFile, REL_FAILURE)\n        return\n    }\n\n    if (!ProcessorId || ProcessorId.isEmpty()) {\n        log.error \"FATAL: 'processor_id' attribute not found or is empty in FlowFile ID ${flowFile.getId()}. Required for API call. Routing to failure.\"\n        session.transfer(flowFile, REL_FAILURE)\n        return\n    }\n\n    // Construct the NiFi Base URL from processgroup_url\n    // Assuming processgroup_url is like \"http://your-nifi-host:8080/nifi\"\n    def uiUri = new URL(processgroup_url)\n    def hostAndPort = \"${uiUri.protocol}://${uiUri.host}:${uiUri.port}\"\n    def nifiBaseUrl = \"${hostAndPort}/nifi-api\"\n    log.info \"Derived NiFi API Base URL: ${nifiBaseUrl}\"\n\n    \n    // 2. Get Access Token from file (no fallback to API login)\n    // Use the 'currentAccessTokenFilePath' determined earlier\n    def accessToken = readAccessTokenFromFile(currentAccessTokenFilePath)\n    if (!accessToken) {\n        log.error \"FATAL: Could not obtain access token from file '${currentAccessTokenFilePath}'. Ensure the cron job is running and updating this file. Routing FlowFile to failure.\"\n        session.transfer(flowFile, REL_FAILURE)\n        return\n    }\n\n    // 3. Get Processor Details using the obtained token\n    def processorJson = getProcessorDetails(nifiBaseUrl, accessToken, ProcessorId)\n\n    if (!processorJson) {\n        log.error \"FATAL: Could not retrieve processor details from NiFi API for processor ID: ${ProcessorId}. Routing FlowFile to failure.\"\n        session.transfer(flowFile, REL_FAILURE)\n        return\n    }\n\n    // 4. Extract the parentGroupId from the JSON Response\n    log.info \"Extracting parentGroupId from processor details JSON for FlowFile ID: ${flowFile.getId()}\"\n    def parentGroupId = null\n    try {\n        def slurper = new JsonSlurper()\n        def parsedJson = slurper.parseText(processorJson)\n        parentGroupId = parsedJson?.component?.parentGroupId // Safely access nested property\n    } catch (Exception e) {\n        log.error \"ERROR: Exception during JSON parsing of processor details response for FlowFile ID ${flowFile.getId()}: ${e.message}\", e\n        log.error \"Raw JSON was: ${processorJson}\"\n        session.transfer(flowFile, REL_FAILURE)\n        return\n    }\n\n    if (!parentGroupId) {\n        log.error \"ERROR: Could not find 'parentGroupId' in the JSON response for processor ${ProcessorId}. Routing FlowFile to failure.\"\n        session.transfer(flowFile, REL_FAILURE)\n        return\n    }\n\n    log.info \"The parent Process Group ID for processor ${ProcessorId} is: ${parentGroupId}\"\n\n    // 5. Construct the NiFi UI Link\n    // Re-use the original processgroup_url for the UI link\n    def nifiUiLink = \"${processgroup_url}/#/process-groups/${parentGroupId}\"\n    log.info \"Constructed NiFi UI Link: ${nifiUiLink}\"\n\n    // 6. Add new attributes to the FlowFile\n    flowFile = session.putAttribute(flowFile, \"nifi.ui.link\", nifiUiLink)\n    flowFile = session.putAttribute(flowFile, \"nifi.processor.id\", ProcessorId) // Ensure this is added\n    flowFile = session.putAttribute(flowFile, \"nifi.parent.group.id\", parentGroupId) // Add parentGroupId as well\n\n    log.info \"Added attributes 'nifi.ui.link', 'nifi.processor.id', and 'nifi.parent.group.id' to FlowFile ${flowFile.getId()}.\"\n\n    // Transfer FlowFile to success relationship\n    session.transfer(flowFile, REL_SUCCESS)\n\n} catch (e) {\n    log.error(\"Error processing FlowFile ${flowFile?.getId()}: ${e.getMessage()}\", e)\n    session.transfer(flowFile, REL_FAILURE) // Catch any unexpected errors\n}","Module Directory":null},"propertyDescriptors":{"Script File":{"name":"Script File","displayName":"Script File","identifiesControllerService":false,"sensitive":false,"dynamic":false,"resourceDefinition":{"cardinality":"SINGLE","resourceTypes":["FILE"]}},"Script Engine":{"name":"Script Engine","displayName":"Script Engine","identifiesControllerService":false,"sensitive":false,"dynamic":false},"Script Body":{"name":"Script Body","displayName":"Script Body","identifiesControllerService":false,"sensitive":false,"dynamic":false},"Module Directory":{"name":"Module Directory","displayName":"Module Directory","identifiesControllerService":false,"sensitive":false,"dynamic":false,"resourceDefinition":{"cardinality":"MULTIPLE","resourceTypes":["FILE","DIRECTORY"]}}},"style":{},"schedulingPeriod":"0 