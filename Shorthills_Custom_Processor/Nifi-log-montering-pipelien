ase-directory":{"name":"tail-base-directory","displayName":"Base directory","identifiesControllerService":false,"sensitive":false,"dynamic":false},"reread-on-nul":{"name":"reread-on-nul","displayName":"Reread when NUL encountered","identifiesControllerService":false,"sensitive":false,"dynamic":false},"tailfile-maximum-age":{"name":"tailfile-maximum-age","displayName":"Maximum age","identifiesControllerService":false,"sensitive":false,"dynamic":false},"Max Buffer Size":{"name":"Max Buffer Size","displayName":"Max Buffer Size","identifiesControllerService":false,"sensitive":false,"dynamic":false},"File to Tail":{"name":"File to Tail","displayName":"File(s) to Tail","identifiesControllerService":false,"sensitive":false,"dynamic":false},"tailfile-lookup-frequency":{"name":"tailfile-lookup-frequency","displayName":"Lookup frequency","identifiesControllerService":false,"sensitive":false,"dynamic":false},"tail-mode":{"name":"tail-mode","displayName":"Tailing mode","identifiesControllerService":false,"sensitive":false,"dynamic":false}},"style":{},"schedulingPeriod":"30 sec","schedulingStrategy":"TIMER_DRIVEN","executionNode":"ALL","penaltyDuration":"30 sec","yieldDuration":"1 sec","bulletinLevel":"WARN","runDurationMillis":0,"concurrentlySchedulableTaskCount":1,"autoTerminatedRelationships":[],"scheduledState":"ENABLED","retryCount":10,"retriedRelationships":[],"backoffMechanism":"PENALIZE_FLOWFILE","maxBackoffPeriod":"10 mins","componentType":"PROCESSOR","groupIdentifier":"1760fe8c-bc47-36e6-816a-80b95ff0e412"},{"identifier":"8c2e155e-0197-1000-871c-a5f096c47f12","instanceIdentifier":"30c23821-481a-332e-a755-02593c8a8de6","name":"MessageCard-ExecuteScript","comments":"","position":{"x":1888.0,"y":-808.0},"type":"org.apache.nifi.processors.script.ExecuteScript","bundle":{"group":"org.apache.nifi","artifact":"nifi-scripting-nar","version":"2.4.0"},"properties":{"Script File":null,"Script Engine":"Groovy","Script Body":"import org.apache.nifi.processor.io.InputStreamCallback\nimport org.apache.nifi.processor.io.OutputStreamCallback\nimport org.apache.nifi.processor.Relationship // Required for Relationship.Builder\nimport org.apache.nifi.flowfile.FlowFile\nimport groovy.json.JsonBuilder\nimport java.nio.charset.StandardCharsets\nimport java.util.regex.Pattern\n\n// Define Relationships explicitly for ExecuteScript, as they are not automatically available like in standard processors\n// You MUST define these in the script itself if you use them by name for transfer.\ndef REL_SUCCESS = new Relationship.Builder().name(\"success\").description(\"Success\").build()\ndef REL_FAILURE = new Relationship.Builder().name(\"failure\").description(\"Failure\").build()\n\n\ndef flowFile = session.get()\nif (flowFile == null) {\n    return\n}\n\ntry {\n    def parsedData = [:]\n    def content = ''\n\n    // Read the content of the FlowFile\n    session.read(flowFile, { InputStream inStream ->\n        content = new String(inStream.bytes, StandardCharsets.UTF_8)\n    } as InputStreamCallback)\n\n    // Get NiFi Base URL from FlowFile attribute (Method 1)\n    def nifiBaseUrl = flowFile.getAttribute('processgroup_url')\n    // This attribute (log_message) holds the log level value passed *into* the formatter script\n    // which then gets embedded in the final formatted message content.\n    // As per your instruction, this attribute contains the actual_log_level, so we will use it directly.\n    def log_message_attr_value = flowFile.getAttribute('LOG_MESSAGE')\n\n\n    // --- REGEX PATTERNS TO MATCH THE EXACT FORMAT GENERATED BY THE PREVIOUS SCRIPT ---\n\n    // 1. Timestamp pattern: Matches \"This Event Occured at Timestamp:\" followed by the timestamp\n    def timestampPattern = Pattern.compile(\n        /^This Event Occured at Timestamp:(\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2},\\d{3})\\s*$/,\n        Pattern.MULTILINE\n    )\n\n    // 2. Traceback Line pattern: Captures Process Group, Processor, and FlowFile details\n    // Group 1: PG Name, Group 2: PG ID, Group 3: Proc Name, Group 4: Proc ID, Group 5: FF Name, Group 6: FF ID\n    def tracebackPattern = Pattern.compile(\n        /^Process_Group_name\\(_id\\)\\.Processor_name\\(_id\\)\\.flowfile_name\\(_id\\):\\s*\\[(.*)\\((.*)\\)\\]\\.\\[(.*)\\((.*)\\)\\]\\.\\[(.*)\\((.*)\\)\\],\\s*$/,\n        Pattern.MULTILINE\n    )\n\n    // 3. Log Message pattern: Matches the \"log_message Message: \" where log_message is in quotes\n    // Group 1: The actual log level (e.g., \"ERROR\", \"INFO\") - parsed from content, but NOT used for `actual_log_level` due to `log_message_attr_value`\n    // Group 2: The specific log message content (can be multi-line due to DOTALL)\n    def logMessagePattern = Pattern.compile(\n        /^\"(.*?)\" Message: \"(.*)\"\\s*$/,\n        Pattern.DOTALL | Pattern.MULTILINE // DOTALL for multiline log message content\n    )\n\n\n    // --- Extracting data into parsedData map ---\n\n    // Extract Timestamp\n    def matcherTimestamp = (content =~ timestampPattern)\n    if (matcherTimestamp.find()) {\n        parsedData['timestamp'] = matcherTimestamp.group(1)?.trim()\n    } else {\n        parsedData['timestamp'] = \"N/A\"\n        log.warn(\"ExecuteScript (Parsing): Could not find Timestamp field.\")\n    }\n\n    // Extract Traceback components\n    def matcherTraceback = (content =~ tracebackPattern)\n    if (matcherTraceback.find()) {\n        parsedData['process_group_name'] = matcherTraceback.group(1)?.trim()\n        parsedData['process_group_id'] = matcherTraceback.group(2)?.trim()\n        parsedData['processor_name'] = matcherTraceback.group(3)?.trim()\n        parsedData['processor_id'] = matcherTraceback.group(4)?.trim()\n        parsedData['flowfile_name'] = matcherTraceback.group(5)?.trim()\n        parsedData['flowfile_id'] = matcherTraceback.group(6)?.trim()\n    } else {\n        // Provide N/A fallbacks if traceback line is not found\n        parsedData['process_group_name'] = \"N/A\"\n        parsedData['process_group_id'] = \"N/A\"\n        parsedData['processor_name'] = \"N/A\"\n        parsedData['processor_id'] = \"N/A\"\n        parsedData['flowfile_name'] = \"N/A\"\n        parsedData['flowfile_id'] = \"N/A\"\n        log.warn(\"ExecuteScript (Parsing): Could not find the combined Traceback line.\")\n    }\n\n    // Extract Log Message and its type (e.g., \"ERROR\", \"INFO\")\n    def matcherLogMessage = (content =~ logMessagePattern)\n    if (matcherLogMessage.find()) {\n        // As per your instruction, actual_log_level comes from the attribute, not parsed content\n        parsedData['actual_log_level'] = log_message_attr_value ?: \"UNKNOWN\"\n        // The message content itself is parsed from Group 2\n        parsedData['log_message_content'] = matcherLogMessage.group(2)?.trim()\n    } else {\n        // If log message pattern not found, use attribute for level and full content as fallback for message\n        parsedData['actual_log_level'] = log_message_attr_value ?: \"UNKNOWN\" // Still use attribute as primary source\n        parsedData['log_message_content'] = \"Could not parse specific log message. Full content:\\n\" + content.trim()\n        log.warn(\"ExecuteScript (Parsing): Could not find expected 'log_message Message' field. Using full content as fallback.\")\n    }\n    \n    // --- Construct the combined traceback string for the MessageCard fact ---\n    // This reconstructs the string exactly as it appears in your formatted message\n    def combinedTracebackFactValue = \"[${parsedData['process_group_name'] ?: 'N/A'}(${parsedData['process_group_id'] ?: 'N/A'})].\" +\n                                     \"[${parsedData['processor_name'] ?: 'N/A'}(${parsedData['processor_id'] ?: 'N/A'})].\" +\n                                     \"[${parsedData['flowfile_name'] ?: 'N/A'}(${parsedData['flowfile_id'] ?: 'N/A'})]\"\n     // --- Conditional URL Selection ---\n    def potentialActions = []\n    def processorId = parsedData['processor_id']\n    def flowfileId = parsedData['flowfile_id']\n    def process_group_id = parsedData['process_group_id']\n\n    if (processorId != \"N/A\" && (flowfileId == \"N/A\" || flowfileId == null || flowfileId == \"FlowFile_ID_Not_In_Log\")) {\n        // Case a) if there is processor id only in log\n        potentialActions.add([\n            \"@type\": \"OpenUri\",\n            \"name\": \"View Processor Provenance\",\n            \"targets\": [\n                [\n                    \"os\": \"default\",\n                    \"uri\": \"${nifiBaseUrl}/#/provenance?componentId=${processorId}\"\n                ]\n            ]\n        ])\n    } else if (processorId != \"N/A\" && flowfileId != \"N/A\" && flowfileId != null) {\n        // Case b) if there is component id and flowfile uuid present in log\n        potentialActions.add([\n            \"@type\": \"OpenUri\",\n            \"name\": \"View Provenance (Component & FlowFile)\",\n            \"targets\": [\n                [\n                    \"os\": \"default\",\n                    \"uri\": \"${nifiBaseUrl}/#/provenance?componentId=${processorId}&flowFileUuid=${flowfileId}\"\n                ]\n            ]\n        ])\n        potentialActions.add([\n            \"@type\": \"OpenUri\",\n            \"name\": \"View Provenance (FlowFile Only)\",\n            \"targets\": [\n                [\n                    \"os\": \"default\",\n                    \"uri\": \"${nifiBaseUrl}/#/provenance?flowFileUuid=${flowfileId}\"\n                ]\n            ]\n        ])\n    }\n    // Add a generic \"View NiFi Flow\" action if no specific IDs are available or as a fallback\n    potentialActions.add([\n        \"@type\": \"OpenUri\",\n        \"name\": \"View NiFi Flow of Root Processor Group\",\n        \"targets\": [\n            [\n                \"os\": \"default\",\n                \"uri\": \"${nifiBaseUrl}/#/process-groups/${process_group_id}\"\n            ]\n        ]\n    ])\n    def nifi_ui_link\n    if (flowFile.getAttribute('nifi.ui.link') != null && !flowFile.getAttribute('nifi.ui.link').isEmpty()) {\n        nifi_ui_link = flowFile.getAttribute('nifi.ui.link')\n        potentialActions.add([\n        \"@type\": \"OpenUri\",\n        \"name\": \"View NiFi Flow of Processor Group Containing Processor_name:${parsedData['processor_name' ?: 'N/A']},Processor_id:${parsedData['processor_id' ?: 'N/A']}\",\n        \"targets\": [\n            [\n                \"os\": \"default\",\n                \"uri\": \"${nifi_ui_link}\"\n            ]\n        ]\n    ])\n       \n       \n    } else {\n      log.info \"ProcessorId not Present in current log.\"\n     }\n\n    // --- Construct the MessageCard JSON payload with the desired facts ---\n    def messageCard = [\n        \"@type\": \"MessageCard\",\n        \"@context\": \"http://schema.org/extensions\",\n        \"themeColor\": \"FF0000\", // Red for error\n        \"summary\": \"NiFi Notification\",\n        \"sections\": [\n            [\n                // Use actual_log_level from parsedData (which now comes from the attribute)\n                \"activityTitle\": \"**${parsedData['actual_log_level'] ?: 'Error'} Occurred in NiFi Pipeline: ${parsedData['process_group_name'] ?: 'N/A'}**\",\n                \"activitySubtitle\": \"**Traceback**\",\n                \"facts\": [\n                    [name: \"Timestamp:\", value: parsedData['timestamp']],\n                    // This fact combines all traceback details into a single line, as requested\n                    [name: \"Process_Group_name(_id).Processor_name(_id).flowfile_name(_id):\", value: combinedTracebackFactValue],\n                    // This fact uses the dynamically extracted log level for the name, and the message content\n                    [name: \"${parsedData['actual_log_level'] ?: 'Log'} Message:\", value: parsedData['log_message_content']]\n                ],\n                \"markdown\": true\n            ]\n        ],\n        \"potentialAction\": potentialActions\n    ]\n\n    def jsonOutputForTeams = new JsonBuilder(messageCard).toPrettyString()\n\n    // Write the JSON to the flow file\n    flowFile = session.write(flowFile, { OutputStream outStream ->\n        outStream.write(jsonOutputForTeams.getBytes(StandardCharsets.UTF_8))\n    } as OutputStreamCallback)\n\n    // Set content type to application/json\n    flowFile = session.putAttribute(flowFile, \"mime.type\", \"application/json\")\n    session.transfer(flowFile, REL_SUCCESS)\n\n} catch (e) {\n    log.error(\"Failed to process flowfile due to \" + e.getMessage(), e)\n    session.transfer(flowFile, REL_FAILURE)\n}","Module Directory":null},"propertyDescriptors":{"Script File":{"name":"Script File","displayName":"Script File","identifiesControllerService":false,"sensitive":false,"dynamic":false,"resourceDefinition":{"cardinality":"SINGLE","resourceTypes":["FILE"]}},"Script Engine":{"name":"Script Engine","displayName":"Script Engine","identifiesControllerService":false,"sensitive":false,"dynamic":false},"Script Body":{"name":"Script Body","displayName":"Script Body","identifiesControllerService":false,"sensitive":false,"dynamic":false},"Module Directory":{"name":"Module Directory","displayName":"Module Directory","identifiesControllerService":false,"sensitive":false,"dynamic":false,"resourceDefinition":{"cardinality":"MULTIPLE","resourceTypes":["FILE","DIRECTORY"]}}},"style":{},"schedulingPeriod":"0 sec","schedulingStrategy":"TIMER_DRIVEN","executionNode":"ALL","penaltyDuration":"30 sec","yieldDuration":"1 sec","bulletinLevel":"WARN","runDurationMillis":0,"concurrentlySchedulableTaskCount":1,"autoTerminatedRelationships":[],"scheduledState":"ENABLED","retryCount":10,"retriedRelationships":[],"backoffMechanism":"PENALIZE_FLOWFILE","maxBackoffPeriod":"10 mins","componentType":"PROCESSOR","groupIdentifier":"1760fe8c-bc47-36e6-816a-80b95ff0e412"},{"identifier":"c6e19763-a917-316a-0000-000068bf5b70","instanceIdentifier":"5d01149e-b0cc-3625-b5f5-7f1ec193af71","name":"LOG_LEVE